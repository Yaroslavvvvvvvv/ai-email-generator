# Supabase project credentials — https://supabase.com/dashboard → Project Settings → API Keys
SUPABASE_URL=https://your-project.supabase.co

# Publishable (anon) key. Safe to expose: it reaches the browser by design and
# every table is guarded by row level security.
SUPABASE_KEY=

# Secret (service_role) key. Server only — it bypasses row level security and
# must never be sent to the client or committed.
SUPABASE_SERVICE_KEY=
